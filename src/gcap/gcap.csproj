<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Gcap</RootNamespace>
    <AssemblyName>gcap</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.2.0</Version>
    <!-- dotnet publish -c Release で単一ファイル exe (ランタイム同梱) を生成 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 解析で判明した知識は Python 版と共有する (単一の情報源) -->
    <EmbeddedResource Include="..\..\tools\gcap\wpix\knowledge\type_bases.json" LogicalName="type_bases.json" />
  </ItemGroup>

</Project>
